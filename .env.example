# ---- StudioSpace client environment ----
# Copy this file to .env.local and fill in real values. Never commit .env.local.

# Public URL of this app (used for BetterAuth callbacks)
NEXT_PUBLIC_APP_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000

# Express API base. The Next rewrite proxies /api/v1/* to this host,
# so cookies stay first-party.
SERVER_URL=http://localhost:5000

# MUST match the server's values exactly
JWT_SECRET=replace_with_at_least_32_random_characters
BETTER_AUTH_SECRET=replace_with_at_least_32_random_characters

# MongoDB (used by the BetterAuth Mongo adapter on the server side of Next)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/studiospace?retryWrites=true&w=majority

# Google OAuth (optional until you enable social login)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Image hosting
IMGBB_API_KEY=
